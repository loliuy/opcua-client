{
  "name": "@tier0/opcua-client",
  "version": "0.6.4",
  "description": "High-scale OPC UA client nodes for Node-RED powered by open62541",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loliuy/opcua-client.git"
  },
  "main": "index.js",
  "gypfile": true,
  "files": [
    "binding.gyp",
    "index.js",
    "lib",
    "nodes",
    "src",
    "scripts",
    "prebuilds",
    "vendor",
    "README.md",
    "BENCHMARK.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "install": "node scripts/install.js",
    "build:open62541": "bash scripts/build-open62541.sh",
    "build:offline-prebuild": "bash scripts/build-offline-prebuild.sh",
    "build:test-server": "bash scripts/build-test-server.sh",
    "build": "node-gyp rebuild",
    "clean": "node-gyp clean",
    "test": "node --test test/*.test.js",
    "test:native": "node test/native.integration.js && node test/native.queue.integration.js && node test/native.command-queue.integration.js && node test/reconnect.integration.js",
    "test:reconnect": "node test/reconnect.integration.js",
    "test:secure": "node test/secure.integration.js",
    "test:offline-runtime": "node scripts/verify-runtime.js",
    "test:stress": "node test/stress.js",
    "test:nodered": "node test/nodered.integration.js",
    "test:nodered:reconnect": "OPCUA_NODERED_RECONNECT=1 node test/nodered.integration.js",
    "test:release": "npm test && npm run test:native && npm run test:offline-runtime && npm run test:nodered",
    "prepack": "npm test && node scripts/verify-offline-package.js"
  },
  "keywords": [
    "node-red",
    "opcua",
    "opc-ua",
    "open62541",
    "industrial-iot"
  ],
  "engines": {
    "node": ">=20"
  },
  "node-red": {
    "version": ">=3.1",
    "nodes": {
      "tier0-opcua-connection": "nodes/connection.js",
      "tier0-opcua-browse": "nodes/browse.js",
      "tier0-opcua-read": "nodes/read.js",
      "tier0-opcua-write": "nodes/write.js",
      "tier0-opcua-subscribe": "nodes/subscribe.js"
    }
  },
  "dependencies": {
    "node-addon-api": "^8.3.1"
  },
  "bundledDependencies": [
    "node-addon-api"
  ],
  "devDependencies": {
    "node-gyp": "^11.4.2"
  }
}
